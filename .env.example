# Copy to .env and fill in values. Do not commit .env.

# OpenAI — required when llm_models.yaml uses gpt* aliases (e.g. gpt4mini, gpt51)
CHATGPT_API_KEY=

# RAGAS eval (eval/ragas_eval.py) uses the standard OpenAI client; set one of:
# OPENAI_API_KEY=
# Or: export OPENAI_API_KEY=$CHATGPT_API_KEY before running eval

# Ollama — required for embeddings (mxbai-embed-large) and local chat aliases (qwen7, llama8, …)
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Hugging Face — only if using the huggingface chat alias
# HF_TOKEN=

# Optional overrides (see llm_models.yaml)
# PAGEINDEX_CHAT_MODEL=qwen7
# RAG_CHAT_MODEL=gpt4mini
# RAG_TREE_SEARCH_MODEL=gpt4mini
# RAG_EMBED_MODEL=mxbai-embed-large
